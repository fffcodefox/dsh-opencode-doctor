{
  "name": "dsh-opencode-doctor",
  "version": "0.2.0",
  "description": "Pre-probed OpenCode Go / Zen model routes for DeepSeek Harness — every model is really called once, the verdict is written into its picker name, and the region-blocked ones are routed through your local proxy automatically.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "opencode-zen",
    "pi-ai",
    "model-provider",
    "region-unlock",
    "proxy"
  ],
  "license": "MIT",
  "author": "fffcodefox",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fffcodefox/dsh-opencode-doctor.git"
  },
  "homepage": "https://github.com/fffcodefox/dsh-opencode-doctor#readme",
  "bugs": {
    "url": "https://github.com/fffcodefox/dsh-opencode-doctor/issues"
  },
  "engines": {
    "node": ">=20.18"
  },
  "main": "./lib/index.mjs",
  "bin": {
    "dsh-opencode-doctor": "./bin/doctor.mjs"
  },
  "dependencies": {
    "dsh-model-proxy": "github:windwhiterain/dsh-model-proxy#5d240805f6feb3c0e4e8ddd635bb10d92b43f11b"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "models.catalog.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "render": "node bin/doctor.mjs render",
    "list": "node bin/doctor.mjs list",
    "usage": "node bin/doctor.mjs usage",
    "check": "node bin/doctor.mjs check",
    "probe": "node bin/doctor.mjs probe"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
